<odoo>
    <record id="psi_internship_supervisor_action" model="ir.actions.act_window">
        <field name="name">Opiekunowie</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("share", "=", False), ("active", "=", True)]</field>
    </record>

    <record id="psi_internship_supervisor_list_view" model="ir.ui.view">
        <field name="name">psi.internship.supervisor.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="psi_internship_res_users_form_inherit" model="ir.ui.view">
        <field name="name">psi.internship.res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Praktykanci">
                    <group>
                        <field name="intern_student_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="school"/>
                                <field name="field_of_study"/>
                                <field name="status"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="intern_application_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="school"/>
                                <field name="required_hours"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
