<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="psi_intern_application_list_view" model="ir.ui.view">
        <field name="name">psi.intern.application.list</field>
        <field name="model">psi.intern.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="school"/>
                <field name="field_of_study"/>
                <field name="supervisor_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="psi_intern_application_form_view" model="ir.ui.view">
        <field name="name">psi.intern.application.form</field>
        <field name="model">psi.intern.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Zaakceptuj" class="btn-primary" invisible="status != 'new'"/>
                    <button name="action_reject" type="object" string="Odrzuć" invisible="status != 'new'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="school"/>
                            <field name="field_of_study"/>
                        </group>
                        <group>
                            <field name="required_hours"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="supervisor_id"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <group string="Powiązania">
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="student_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="psi_intern_application_action" model="ir.actions.act_window">
        <field name="name">Zgłoszenia praktykantów</field>
        <field name="res_model">psi.intern.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="psi_intern_application_menu"
        name="Zgłoszenia"
        parent="psi_internship_management_menu_root"
        action="psi_intern_application_action"
        sequence="20"
    />
</odoo>