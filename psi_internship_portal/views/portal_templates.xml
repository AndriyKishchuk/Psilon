<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_internship_entry" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Moja praktyka</t>
                <t t-set="text">Sprawdz swoje godziny, plan obecnosci i najblizsze terminy</t>
                <t t-set="url" t-value="'/my/internship'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_internship" name="Moja praktyka">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <t t-if="message == 'checked_in'">
                    <div class="alert alert-success rounded-4 border-0 shadow-sm">Check in zapisany poprawnie.</div>
                </t>
                <t t-if="message == 'checked_out'">
                    <div class="alert alert-success rounded-4 border-0 shadow-sm">Check out zapisany poprawnie.</div>
                </t>
                <t t-if="message == 'already_checked_in'">
                    <div class="alert alert-warning rounded-4 border-0 shadow-sm">Masz juz aktywny wpis obecnosci.</div>
                </t>
                <t t-if="message == 'no_open_attendance'">
                    <div class="alert alert-warning rounded-4 border-0 shadow-sm">Nie ma aktywnego wpisu do zamkniecia.</div>
                </t>
                <t t-if="message == 'no_student'">
                    <div class="alert alert-danger rounded-4 border-0 shadow-sm">Nie znaleziono praktykanta przypisanego do tego uzytkownika.</div>
                </t>

                <t t-if="student">
                    <div class="rounded-4 p-4 p-lg-5 mb-4 text-white" style="background: linear-gradient(135deg, #4338ca 0%, #7c3aed 55%, #0f172a 100%);">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-8">
                                <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                    <span class="badge rounded-pill bg-white text-dark px-3 py-2 fs-6">
                                        <t t-esc="dict(student._fields['status'].selection).get(student.status)"/>
                                    </span>
                                    <t t-if="student.start_date and student.end_date">
                                        <span class="small opacity-75">
                                            <t t-esc="student.start_date"/> - <t t-esc="student.end_date"/>
                                        </span>
                                    </t>
                                </div>
                                <h1 class="display-5 fw-bold mb-2">Witaj, <t t-esc="student.name"/></h1>
                                <p class="lead mb-0 opacity-75">Twoj panel praktyk w jednym miejscu: profil, godziny, obecnosci i szybkie akcje.</p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <t t-if="student.image_1920">
                                    <img t-att-src="'/web/image?model=psi.intern.student&amp;id=%s&amp;field=image_1920' % student.id"
                                         alt="Student photo"
                                         class="rounded-4 shadow"
                                         style="width: 150px; height: 150px; object-fit: cover; border: 4px solid rgba(255,255,255,0.25);"/>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-lg-5">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-4">
                                        <div>
                                            <div class="text-uppercase text-muted small fw-semibold">Profil praktykanta</div>
                                            <h3 class="mt-2 mb-0"><t t-esc="student.name"/></h3>
                                        </div>
                                        <span class="badge rounded-pill text-bg-light px-3 py-2">Praktykant</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="rounded-4 bg-light p-3">
                                                <div class="text-muted small">Szkola / Uczelnia</div>
                                                <div class="fw-semibold"><t t-esc="student.school or '-'"/></div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="rounded-4 bg-light p-3">
                                                <div class="text-muted small">Kierunek / Profil</div>
                                                <div class="fw-semibold"><t t-esc="student.field_of_study or '-'"/></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="rounded-4 bg-light p-3 h-100">
                                                <div class="text-muted small">Data rozpoczecia</div>
                                                <div class="fw-semibold"><t t-esc="student.start_date or '-'"/></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="rounded-4 bg-light p-3 h-100">
                                                <div class="text-muted small">Data zakonczenia</div>
                                                <div class="fw-semibold"><t t-esc="student.end_date or '-'"/></div>
                                            </div>
                                        </div>
                                        <div class="col-12" t-if="student.supervisor_id">
                                            <div class="rounded-4 bg-light p-3">
                                                <div class="text-muted small">Opiekun praktyk</div>
                                                <div class="fw-semibold"><t t-esc="student.supervisor_id.name"/></div>
                                                <div class="text-muted small mt-1"><t t-esc="student.supervisor_id.email or ''"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="text-muted small text-uppercase fw-semibold mb-2">Suma godzin</div>
                                            <div class="display-6 fw-bold"><t t-esc="student.total_attendance_hours"/></div>
                                            <div class="text-muted small mt-2">Lacznie przepracowane</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="text-muted small text-uppercase fw-semibold mb-2">Obecnosci</div>
                                            <div class="display-6 fw-bold"><t t-esc="attendance_count"/></div>
                                            <div class="text-muted small mt-2">Wszystkie wpisy</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="text-muted small text-uppercase fw-semibold mb-2">Dokumenty</div>
                                            <div class="display-6 fw-bold"><t t-esc="document_count"/></div>
                                            <div class="text-muted small mt-2">Pliki przypisane do praktyki</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                                                <div>
                                                    <div class="text-uppercase text-muted small fw-semibold">Szybkie akcje</div>
                                                    <h4 class="mt-2 mb-0">Obecnosc i kontakt</h4>
                                                </div>
                                                <a href="/my/internship/attendance" class="btn btn-outline-secondary rounded-pill px-4">
                                                    Zobacz plan obecnosci
                                                </a>
                                            </div>

                                            <div class="row g-3 mb-4">
                                                <div class="col-md-6">
                                                    <form action="/my/internship/check_in" method="post" class="h-100">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-success w-100 rounded-4 py-3 fw-semibold" t-att-disabled="current_attendance and 'disabled' or None">
                                                            Check in
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="col-md-6">
                                                    <form action="/my/internship/check_out" method="post" class="h-100">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-dark w-100 rounded-4 py-3 fw-semibold" t-att-disabled="not current_attendance and 'disabled' or None">
                                                            Check out
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="rounded-4 p-4 h-100" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                        <div class="text-muted small text-uppercase fw-semibold mb-2">Aktualny status obecnosci</div>
                                                        <t t-if="current_attendance">
                                                            <div class="fw-semibold mb-1">Jestes aktualnie na praktyce</div>
                                                            <div class="text-muted small">Start: <t t-esc="current_attendance.start_datetime"/></div>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="fw-semibold mb-1">Brak aktywnego wejscia</div>
                                                            <div class="text-muted small">Mozesz rozpoczac praktyke przyciskiem Check in.</div>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="rounded-4 p-4 h-100" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                        <div class="text-muted small text-uppercase fw-semibold mb-2">Kontakt do opiekuna</div>
                                                        <t t-if="student.supervisor_id">
                                                            <div class="fw-semibold mb-1"><t t-esc="student.supervisor_id.name"/></div>
                                                            <div class="text-muted small"><t t-esc="student.supervisor_id.email or 'Brak e-maila'"/></div>
                                                        </t>
                                                        <t t-else="">
                                                            <div class="text-muted small">Nie przypisano jeszcze opiekuna praktyk.</div>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="text-uppercase text-muted small fw-semibold">Najblizszy termin</div>
                                            <h4 class="mt-2 mb-4">Plan obecnosci</h4>

                                            <t t-if="next_attendance">
                                                <div class="rounded-4 p-4" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                                    <div class="row g-3 align-items-center">
                                                        <div class="col-md-4">
                                                            <div class="text-muted small">Start</div>
                                                            <div class="fw-semibold"><span t-field="next_attendance.start_datetime"/></div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="text-muted small">Koniec</div>
                                                            <div class="fw-semibold"><t t-if="next_attendance.end_datetime"><span t-field="next_attendance.end_datetime"/></t><t t-else="">-</t></div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="text-muted small">Liczba godzin</div>
                                                            <div class="fw-semibold"><t t-esc="next_attendance.duration_hours"/></div>
                                                        </div>
                                                    </div>
                                                    <t t-if="next_attendance.note">
                                                        <div class="mt-3 pt-3 border-top">
                                                            <div class="text-muted small">Notatka</div>
                                                            <div><t t-esc="next_attendance.note"/></div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="rounded-4 p-4 text-center text-muted" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                                                    Na ten moment nie masz zadnych przyszlych wpisow w planie obecnosci.
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-warning rounded-4 shadow-sm border-0 p-4">
                        Nie znaleziono praktykanta przypisanego do tego uzytkownika.
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_internship_attendance" name="Plan obecnosci praktykanta">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <h2 class="mb-1">Plan obecnosci</h2>
                        <t t-if="student">
                            <div class="text-muted">Praktykant: <span class="fw-semibold text-dark"><t t-esc="student.name"/></span></div>
                        </t>
                    </div>
                    <a href="/my/internship" class="btn btn-outline-secondary rounded-pill px-4">Wroc do panelu</a>
                </div>

                <t t-if="student and attendances">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Data i godzina rozpoczecia</th>
                                        <th>Data i godzina zakonczenia</th>
                                        <th>Liczba godzin</th>
                                        <th>Status</th>
                                        <th class="pe-4">Notatka</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="attendances" t-as="attendance">
                                        <tr>
                                            <td class="ps-4 fw-semibold"><span t-field="attendance.start_datetime"/></td>
                                            <td><t t-if="attendance.end_datetime"><span t-field="attendance.end_datetime"/></t><t t-else="">-</t></td>
                                            <td><span class="badge text-bg-light rounded-pill px-3 py-2"><t t-esc="attendance.duration_hours"/> h</span></td>
                                            <td><span class="badge rounded-pill text-bg-secondary"><t t-esc="dict(attendance._fields['status'].selection).get(attendance.status)"/></span></td>
                                            <td class="pe-4"><t t-esc="attendance.note or '-'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
                <t t-elif="student">
                    <div class="rounded-4 p-4 text-center text-muted shadow-sm" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                        Nie masz jeszcze zadnych wpisow obecnosci.
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-warning rounded-4 shadow-sm border-0 p-4">
                        Nie znaleziono praktykanta przypisanego do tego uzytkownika.
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
